# Neon Data API endpoint for the photography likes feature.
# Find it in Neon Console -> your project -> Data API -> "API URL".
# Example: https://ep-xxxx-xxxx.data-api.us-east-1.neon.tech
# (No trailing /rest/v1 — the app adds it.)
#
# This URL is public (it ships in the client bundle); access is restricted by
# the GRANTs in db/likes.sql, not by keeping the URL secret. If unset, the
# likes feature is simply hidden.
VITE_NEON_DATA_API_URL=

# Google Books API key for the Book Finder project page.
# Get one at https://console.cloud.google.com — enable the Books API.
VITE_BOOK_API_KEY=
