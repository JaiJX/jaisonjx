# MongoDB Atlas Data API — powers the photography likes feature.
#
# Setup steps:
#   1. Create a free Atlas cluster at https://cloud.mongodb.com
#   2. Enable the Data API: Atlas UI → App Services → Data API
#   3. Copy the base URL (e.g. https://data.mongodb-api.com/app/<app-id>/endpoint/data/v1)
#   4. Create an API key with access restricted to the `portfolio` database,
#      `photo_likes` collection, read + findOneAndUpdate only.
#
# WARNING: VITE_ prefixed vars are bundled into the client. Restrict the API key
# in Atlas to prevent abuse (IP/referrer allowlist + per-collection permissions).
# If these vars are unset, the likes feature is simply hidden.
VITE_MONGODB_DATA_API_URL=
VITE_MONGODB_API_KEY=
# Optional — defaults shown:
VITE_MONGODB_DATA_SOURCE=Cluster0
VITE_MONGODB_DATABASE=portfolio

# Google Books API key for the Book Finder project page.
# Get one at https://console.cloud.google.com — enable the Books API.
# WARNING: This key is bundled into the client-side build (VITE_ prefix means
# it is public). Restrict it in Google Cloud Console under Application
# restrictions → HTTP referrers and set a tight daily quota to prevent abuse.
# For production, consider proxying Books API requests through a backend or
# serverless function to keep the key out of the browser entirely.
# The corresponding GitHub Actions secret must be named VITE_BOOK_API_KEY.
VITE_BOOK_API_KEY=
